# ---- Insytix backend configuration ----
# Copy this file to ".env" (it works fine with these defaults for a local demo).

# HTTP port the API listens on
PORT=8080

# Where the SQLite database file is created (relative to the backend folder)
DB_FILE=./data/insytix.db

# Secret used to sign JWT access tokens (change in production)
JWT_SECRET=insytix-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Secret used to encrypt the Shopify access token at rest (32+ chars recommended)
ENCRYPTION_KEY=insytix-dev-encryption-key-change-me

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Default Shopify Admin API version (GraphQL Admin API). 2026-10 is the latest stable.
SHOPIFY_API_VERSION=2026-10

# ---- Bundled FTP demo server (npm run ftp-demo) ----
# Lets the FTP supplier method work fully offline against a local server.
FTP_DEMO_PORT=2121
FTP_DEMO_USER=insytix
FTP_DEMO_PASSWORD=insytix123
