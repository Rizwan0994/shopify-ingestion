# Optional. By default the dev server proxies /api to the backend (see vite.config.js),
# so you don't need to set anything for local development.

# Override the backend origin the dev server proxies to:
# VITE_API_PROXY=http://localhost:8080

# Or bypass the proxy and call the backend directly (must include /api):
# VITE_API_BASE_URL=http://localhost:8080/api
